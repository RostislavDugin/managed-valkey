{
	order rate_limit before reverse_proxy
}

app.h3llo-demo.com {
	@api path /v1/* /livez /readyz /health /valkey-health
	handle @api {
		rate_limit {
			zone auth {
				match {
					path /v1/auth/*
				}
				key {remote_host}
				events 10
				window 1m
			}
			zone api {
				match {
					path /v1/*
				}
				key {remote_host}
				events 120
				window 1m
			}
			zone health {
				match {
					path /health /valkey-health
				}
				key {remote_host}
				events 30
				window 1m
			}
		}
		reverse_proxy api:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

logs.h3llo-demo.com {
	@otlp {
		method POST
		path /insert/opentelemetry/v1/logs
	}
	handle @otlp {
		reverse_proxy victorialogs:9428 {
			header_up -Authorization
		}
	}
	handle /select/* {
		reverse_proxy victorialogs:9428 {
			header_up -Authorization
		}
	}
	handle {
		respond 404
	}
}
