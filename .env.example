JWT_SECRET=Q1234567
K3S_TOKEN=Q1234567

# DB
POSTGRES_USER=managed_valkey
POSTGRES_DB=managed_valkey
POSTGRES_PASSWORD=Q1234567
POSTGRES_PORT=45432
DATABASE_URL=postgres://managed_valkey:${POSTGRES_PASSWORD}@127.0.0.1:45432/managed_valkey?sslmode=disable
TEST_DATABASE_URL=postgres://managed_valkey:${POSTGRES_PASSWORD}@127.0.0.1:45432/managed_valkey_test?sslmode=disable

# Logs & metrics
APP_ENV=dev
LOG_LEVEL=info
VALKEY_METRICS_RETENTION=168h

# Server
HTTP_ADDR=:8080
VALKEY_BASE_DOMAIN=valkey.localhost
VALKEY_PUBLIC_PORT=41379

# Valkey instances limits
VALKEY_INSTANCE_MAX_VCPU=4
VALKEY_INSTANCE_MAX_RAM_GB=16

# Managed K8S limits
MANAGED_K8S_NODE_VCPU=24
MANAGED_K8S_NODE_RAM_GB=48

# Pricing
VALKEY_INSTANCE_VCPU_PRICE_COINS_PER_HOUR=125
VALKEY_INSTANCE_RAM_GB_PRICE_COINS_PER_HOUR=50

# K8S
VALKEY_SYSTEM_NAMESPACE=valkey-system
VALKEY_IMAGE=valkey/valkey:8.1.9

# Production: заполнить перед запуском production compose.
API_KUBECONFIG_DIR=
VL_INGEST_PASSWORD_HASH=
VL_VIEW_PASSWORD_HASH=
# Оператор получает пароль из Secret valkey-logs-export с ключом password.
# VL_OTLP_USERNAME=valkey-operator
# VL_OTLP_PASSWORD_FILE=/var/run/valkey-logs/password
