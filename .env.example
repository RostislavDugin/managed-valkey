# Этот файл предназначен только для локальной разработки.
# Рабочий .env создаёт GitHub Actions. В нём есть только POSTGRES_PASSWORD и JWT_SECRET.
JWT_SECRET=local-development-jwt-secret
K3S_TOKEN=Q1234567

# DB
POSTGRES_USER=managed_valkey
POSTGRES_DB=managed_valkey
POSTGRES_PASSWORD=local-development-postgres-password
POSTGRES_PORT=45432
DATABASE_URL=postgres://managed_valkey:${POSTGRES_PASSWORD}@127.0.0.1:45432/managed_valkey?sslmode=disable

# Logs & metrics
APP_ENV=dev
LOG_LEVEL=info
VALKEY_METRICS_RETENTION=168h

# Server
HTTP_ADDR=:8080
VALKEY_BASE_DOMAIN=valkey.localhost
VALKEY_PUBLIC_PORT=41379

# Valkey instances limits
VALKEY_INSTANCE_MAX_VCPU=4
VALKEY_INSTANCE_MAX_RAM_GB=16

# Топология Managed Kubernetes и резерв инфраструктуры каждой ноды
MANAGED_K8S_NODE_COUNT=3
MANAGED_K8S_NODE_CAPACITY_VCPU=4
MANAGED_K8S_NODE_CAPACITY_RAM_GB=16
MANAGED_K8S_NODE_RESERVED_CPU_MILLI=2666
MANAGED_K8S_NODE_RESERVED_RAM_MIB=10922

# Pricing
VALKEY_INSTANCE_VCPU_PRICE_COINS_PER_HOUR=125
VALKEY_INSTANCE_RAM_GB_PRICE_COINS_PER_HOUR=50

# K8S
VALKEY_SYSTEM_NAMESPACE=valkey-system
VALKEY_IMAGE=valkey/valkey:8.1.9
VALKEY_OPERATOR_CIDRS=
