set shell := ["bash", "-euo", "pipefail", "-c"]
set dotenv-path := "../.env"

export GOTOOLCHAIN := "auto"

root := justfile_directory() / ".."
test_database_url := env(
    "TEST_DATABASE_URL",
    "postgres://managed_valkey:managed_valkey@127.0.0.1:45432/managed_valkey_test?sslmode=disable"
)

run: migration-up
    cd {{ root }} && KUBECONFIG={{ quote(root / "tmp/k3s/api.kubeconfig") }} go run ./api/cmd/api

test:
    cd {{ root }} && if ! docker compose -f docker-compose.dev.yml exec -T postgres \
        psql --username "${POSTGRES_USER:-managed_valkey}" --dbname postgres --tuples-only --no-align \
        --command "SELECT 1 FROM pg_database WHERE datname = 'managed_valkey_test'" | grep -qx 1; then \
        docker compose -f docker-compose.dev.yml exec -T postgres \
            createdb --username "${POSTGRES_USER:-managed_valkey}" managed_valkey_test; \
    fi
    cd {{ root }} && go tool goose -dir migrations postgres {{ quote(test_database_url) }} up
    cd {{ root }} && TEST_DATABASE_URL={{ quote(test_database_url) }} go test ./api/... ./internal/...

migration-up:
    cd {{ root }} && go tool goose -dir migrations postgres "${DATABASE_URL:?переменная DATABASE_URL обязательна}" up

migration-down:
    cd {{ root }} && go tool goose -dir migrations postgres "${DATABASE_URL:?переменная DATABASE_URL обязательна}" down

migration-generate name:
    cd {{ root }} && go tool goose -dir migrations create {{ name }} sql
