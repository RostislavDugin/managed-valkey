set shell := ["bash", "-euo", "pipefail", "-c"]
set dotenv-path := "../.env"

export GOTOOLCHAIN := "auto"

root := justfile_directory() / ".."

run: _check-generated
    test -f {{ quote(root / "tmp/k3s/dev/operator.kubeconfig") }} || \
        { echo "сначала выполните scripts/k3s_bootstrap.sh" >&2; exit 1; }
    test -f {{ quote(root / "tmp/k3s/dev/operator.env") }} || \
        { echo "сначала выполните scripts/k3s_bootstrap.sh для настройки сетевого доступа" >&2; exit 1; }
    set -a && source {{ quote(root / "tmp/k3s/dev/operator.env") }} && set +a && \
        cd {{ root }} && KUBECONFIG={{ quote(root / "tmp/k3s/dev/operator.kubeconfig") }} go run ./operator/cmd/operator

format:
    cd {{ root }} && find operator internal -type f -name '*.go' -print0 | \
        xargs -0 --no-run-if-empty go tool golangci-lint fmt --config .golangci.yml
    cd {{ root }} && git add -- operator internal

lint:
    cd {{ root }} && go tool golangci-lint run --config .golangci.yml ./operator/... ./internal/...
    cd {{ root }} && scripts/check_operator_generated.sh
    cd {{ root }} && go build ./operator/... ./internal/...
    cd {{ root }} && go mod tidy -diff

test:
    cd {{ root }} && scripts/test_operator_ci.sh

test-full:
    cd {{ root }} && scripts/test_operator.sh

_generate:
    cd {{ root }} && go tool controller-gen object paths=./operator/api/v1alpha1/...
    cd {{ root }} && go tool controller-gen crd paths=./operator/api/v1alpha1/... \
        output:crd:artifacts:config=operator/config/crd
    cd {{ root }} && go tool controller-gen rbac:roleName=managed-valkey-operator paths=./operator/internal/... \
        output:rbac:artifacts:config=operator/config/rbac

_check-generated:
    cd {{ root }} && scripts/check_operator_generated.sh
